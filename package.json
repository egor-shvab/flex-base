{
  "name": "flex-base",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "node scripts/preview.mjs",
    "postinstall": "prisma generate && nuxt prepare",
    "typecheck": "nuxt typecheck && tsc -p test/e2e/tsconfig.json",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:nuxt": "vitest run --project nuxt",
    "test:integration": "npm run db:up && vitest run --config vitest.integration.config.ts",
    "test:watch": "vitest",
    "test:coverage": "npm run db:up && npm run coverage:collect",
    "coverage:collect": "npm run coverage:unit && npm run coverage:integration && vitest run --merge-reports --coverage",
    "coverage:unit": "vitest run --coverage --coverage.reporter=none --reporter=default --reporter=blob --outputFile.blob=.vitest-reports/unit.json",
    "coverage:integration": "vitest run --config vitest.integration.config.ts --coverage --coverage.reporter=none --reporter=default --reporter=blob --outputFile.blob=.vitest-reports/integration.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose up -d --wait",
    "db:studio": "prisma studio",
    "db:seed": "tsx --tsconfig tsconfig.seed.json prisma/seed/index.ts",
    "test:e2e": "npm run db:up && playwright install chromium && playwright test",
    "test:e2e:ui": "npm run db:up && playwright install chromium && playwright test --ui"
  },
  "dependencies": {
    "@nuxt/icon": "^2.3.1",
    "@pinia/nuxt": "^1.0.1",
    "@prisma/adapter-pg": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "bcrypt": "^6.0.0",
    "h3": "^1.15.11",
    "jsonwebtoken": "^9.0.3",
    "nitropack": "^2.13.4",
    "nuxt": "^4.5.0",
    "ofetch": "^1.5.1",
    "pinia": "^4.0.2",
    "vue": "^3.5.40",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@iconify-json/mdi": "^1.2.3",
    "@nuxt/eslint": "^1.16.0",
    "@nuxt/test-utils": "^4.1.0",
    "@playwright/test": "^1.62.1",
    "@types/bcrypt": "^6.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@vitest/coverage-v8": "^4.1.10",
    "@vue/test-utils": "^2.4.11",
    "dotenv": "^17.4.2",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "happy-dom": "^20.11.1",
    "prettier": "^3.9.6",
    "prisma": "^7.9.0",
    "sass-embedded": "^1.100.0",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.8"
  }
}
