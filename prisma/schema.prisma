generator client {
  provider = "prisma-client"
  output   = "../server/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum FieldType {
  TEXT
  NUMBER
  BOOLEAN
  DATE
  SELECT
  RELATION
}

enum WorkspacePermission {
  WORKSPACE_UPDATE
  MEMBERS_INVITE
  MEMBERS_MANAGE
  ROLES_MANAGE
  TABLES_MANAGE
  RECORDS_CREATE
  RECORDS_UPDATE
  RECORDS_DELETE
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())

  lastWorkspaceId String?
  lastWorkspace   Workspace? @relation("LastWorkspace", fields: [lastWorkspaceId], references: [id], onDelete: SetNull)

  ownedWorkspaces Workspace[]           @relation("WorkspaceOwner")
  memberships     WorkspaceMember[]
  sentInvitations WorkspaceInvitation[]
  createdRecords  Record[]              @relation("RecordCreatedBy")
  updatedRecords  Record[]              @relation("RecordUpdatedBy")
}

model Workspace {
  id       String @id @default(cuid())
  // The address in every URL: random, so it neither counts workspaces nor leaks a name
  publicId String @unique
  name     String
  ownerId  String
  owner    User   @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Restrict)

  tableCounter Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members      WorkspaceMember[]
  roles        WorkspaceRole[]
  invitations  WorkspaceInvitation[]
  tables       Table[]
  lastVisitors User[]                @relation("LastWorkspace")

  @@index([ownerId])
}

model WorkspaceRole {
  id          String                @id @default(cuid())
  workspaceId String
  workspace   Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  permissions WorkspacePermission[]
  createdAt   DateTime              @default(now())

  members     WorkspaceMember[]
  invitations WorkspaceInvitation[]

  @@unique([workspaceId, name])
  // The target of `WorkspaceMember`'s role key, which carries the workspace too
  @@unique([workspaceId, id])
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Keyed with the workspace, so a member can only hold a role of their own workspace. NoAction,
  // not Restrict: deleting a workspace cascades to roles and members in one statement, and
  // RESTRICT would fire mid-statement if a role went before the member using it
  roleId      String
  role        WorkspaceRole @relation(fields: [workspaceId, roleId], references: [workspaceId, id], onDelete: NoAction)
  createdAt   DateTime      @default(now())

  @@unique([workspaceId, userId])
  @@index([userId])
  @@index([roleId])
}

model WorkspaceInvitation {
  id          String        @id @default(cuid())
  workspaceId String
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  // Lowercased: matched against `User.email` by equality, which keeps the index usable
  email       String
  // NoAction for the reason `WorkspaceMember.role` gives
  roleId      String
  role        WorkspaceRole @relation(fields: [workspaceId, roleId], references: [workspaceId, id], onDelete: NoAction)
  invitedById String?
  invitedBy   User?         @relation(fields: [invitedById], references: [id], onDelete: SetNull)
  expiresAt   DateTime
  createdAt   DateTime      @default(now())

  @@unique([workspaceId, email])
  @@index([email])
  @@index([roleId])
}

model Table {
  id          String    @id @default(cuid())
  name        String
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  number Int

  recordCounter Int @default(0)

  fields    Field[]
  records   Record[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workspaceId, name])
  @@unique([workspaceId, number])
}

model Field {
  id       String    @id @default(cuid())
  tableId  String
  table    Table     @relation(fields: [tableId], references: [id], onDelete: Cascade)
  name     String
  key      String // machine key, immutable after creation
  type     FieldType
  required Boolean   @default(false)
  options  Json?
  order    Int       @default(0)

  indexed Boolean @default(false)

  createdAt DateTime @default(now())

  @@unique([tableId, key])
}

model Record {
  id      String @id @default(cuid())
  tableId String
  table   Table  @relation(fields: [tableId], references: [id], onDelete: Cascade)

  number Int

  data      Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdById String?
  createdBy   User?   @relation("RecordCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById String?
  updatedBy   User?   @relation("RecordUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  // The (tableId, createdAt) index stays: the default newest-first order cannot use this one
  @@unique([tableId, number])
  @@index([tableId, createdAt])
}
