generator client {
  provider = "prisma-client"
  output   = "../server/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum FieldType {
  TEXT
  NUMBER
  BOOLEAN
  DATE
  SELECT
  RELATION
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  tableCounter Int @default(0)

  tables Table[]
}

model Table {
  id     String @id @default(cuid())
  name   String
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  number Int

  recordCounter Int @default(0)

  fields    Field[]
  records   Record[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, name])
  @@unique([userId, number])
}

model Field {
  id        String    @id @default(cuid())
  tableId   String
  table     Table     @relation(fields: [tableId], references: [id], onDelete: Cascade)
  name      String
  key       String // machine key, immutable after creation
  type      FieldType
  required  Boolean   @default(false)
  options   Json?
  order     Int       @default(0)

  indexed   Boolean   @default(false)

  createdAt DateTime  @default(now())

  @@unique([tableId, key])
}

model Record {
  id      String @id @default(cuid())
  tableId String
  table   Table  @relation(fields: [tableId], references: [id], onDelete: Cascade)

  number Int

  data      Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // The (tableId, createdAt) index stays: the default newest-first order cannot use this one
  @@unique([tableId, number])
  @@index([tableId, createdAt])
}
