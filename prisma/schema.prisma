generator client {
  provider = "prisma-client"
  output   = "../server/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum FieldType {
  TEXT
  NUMBER
  BOOLEAN
  DATE
  SELECT
  RELATION
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  tables       Table[]
}

model Table {
  id        String   @id @default(cuid())
  name      String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fields    Field[]
  records   Record[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // No separate @@index([userId]): the unique above is a btree on (userId, name), and a
  // left prefix of it already serves every lookup by userId alone.
  @@unique([userId, name])
}

model Field {
  id        String    @id @default(cuid())
  tableId   String
  table     Table     @relation(fields: [tableId], references: [id], onDelete: Cascade)
  name      String // display label, editable
  key       String // machine key, immutable after creation
  type      FieldType
  required  Boolean   @default(false)
  options   Json? // SELECT: { choices: string[] } ; RELATION: { targetTableId: string }
  order     Int       @default(0)
  createdAt DateTime  @default(now())

  // Likewise: (tableId, key) covers the per-table list by its left prefix.
  @@unique([tableId, key])
}

// (tableId, createdAt) covers both the per-table lookup (by its left prefix) and the
// default ordering, which Postgres scans backwards for newest-first. Sorting by a JSONB
// key stays unindexed on purpose — keys are user-defined per table, so no general index
// applies; that is the first scaling limit this schema will hit.
model Record {
  id        String   @id @default(cuid())
  tableId   String
  table     Table    @relation(fields: [tableId], references: [id], onDelete: Cascade)
  data      Json     @default("{}") // keyed by Field.key
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tableId, createdAt])
}
