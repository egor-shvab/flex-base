generator client {
  provider = "prisma-client"
  output   = "../server/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum FieldType {
  TEXT
  NUMBER
  BOOLEAN
  DATE
  SELECT
  RELATION
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  tables       Table[]
}

model Table {
  id        String   @id @default(cuid())
  name      String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fields    Field[]
  records   Record[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, name])
  @@index([userId])
}

model Field {
  id        String    @id @default(cuid())
  tableId   String
  table     Table     @relation(fields: [tableId], references: [id], onDelete: Cascade)
  name      String // display label, editable
  key       String // machine key, immutable after creation
  type      FieldType
  required  Boolean   @default(false)
  options   Json? // SELECT: { choices: string[] } ; RELATION: { targetTableId: string }
  order     Int       @default(0)
  createdAt DateTime  @default(now())

  @@unique([tableId, key])
  @@index([tableId])
}

model Record {
  id        String   @id @default(cuid())
  tableId   String
  table     Table    @relation(fields: [tableId], references: [id], onDelete: Cascade)
  data      Json     @default("{}") // keyed by Field.key
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tableId])
}
